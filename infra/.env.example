# 서버 배포 설정. `infra/.env`로 복사해서 채운다.
#
# 이 파일은 예시다. 실제 값이 든 infra/.env는 저장소에 올라가지 않는다.
# 비밀은 여기에만 두고 compose 파일이나 이미지에 넣지 않는다.

# ── 공개 범위 ────────────────────────────────────────────────────────────
# 기본은 루프백이라 서버 밖에서 보이지 않는다. 사내망에 열려면 0.0.0.0으로 바꾼다.
LEP_WEB_BIND=127.0.0.1
LEP_WEB_PORT=3000
LEP_LOG_LEVEL=INFO

# ── 데이터베이스 ─────────────────────────────────────────────────────────
# 계정과 프로젝트가 여기에 남는다. 비워 두면 compose가 기동을 거부한다.
# deploy.sh가 .env에 값이 없으면 무작위로 만들어 채운다.
# 값을 바꾸면 기존 pgdata 볼륨으로는 접속하지 못한다.
LEP_DB_PASSWORD=

# 개발 전용 페이지(/dev/components, /dev/states)를 열지 여부.
LEP_ENABLE_DEV_PAGES=0

# ── 문서 변환 (kordoc) ──────────────────────────────────────────────────
# 이미지에 이미 설치돼 있다. 끄려면 fixture로 바꾼다. 한컴 오피스는 필요 없다.
LEP_ADAPTER_CONVERTER=kordoc

# ── 깃허브 ───────────────────────────────────────────────────────────────
# 개인 액세스 토큰. repo 읽기 권한이면 충분하다.
LEP_ADAPTER_VCS=fixture
LEP_GITHUB_TOKEN=
LEP_GITHUB_REPO=SunhSOO/ERP
# 프로젝트마다 저장소가 다르면 위 대신 아래를 쓴다.
# LEP_GITHUB_REPOS={"prj-daon":"SunhSOO/ERP"}

# ── 옵시디언 볼트 ────────────────────────────────────────────────────────
# 서버에 옵시디언 앱을 설치하지 않는다. 볼트는 마크다운 폴더일 뿐이다.
# 아래 호스트 경로가 컨테이너의 /data/vault로 마운트된다.
# scripts/sync-vault.sh로 사내 PC에서 올린다.
LEP_ADAPTER_VAULT=obsidian
LEP_VAULT_HOST_PATH=./vault
# 프로젝트를 만들면 이 아래에 프로젝트 코드 이름의 폴더가 하나씩 생긴다.

# ── 하이웍스 메일 ────────────────────────────────────────────────────────
# 먼저 하이웍스에서 [메일 > 환경설정 > 기본 설정]의 POP3/IMAP을 사용함으로 켠다.
# 그룹웨어 API 신청 없이 표준 IMAP으로 읽는다. 읽기 전용이라 메일을 지우지 않는다.
LEP_ADAPTER_MAIL=fixture
LEP_HIWORKS_HOST=imaps.hiworks.com
LEP_HIWORKS_PORT=993
LEP_HIWORKS_USER=
LEP_HIWORKS_PASSWORD=
LEP_HIWORKS_FOLDER=INBOX
# 발신 도메인을 프로젝트에 매핑한다. 이것이 자동 분류의 기준이다.
# LEP_HIWORKS_PROJECT_DOMAINS={"고객사도메인.co.kr":"prj-daon"}

# ── 로컬 LLM ─────────────────────────────────────────────────────────────
# 어댑터는 아직 없다(WP-PKD-033). ollama 프로파일로 서버만 미리 띄울 수 있다.
#   docker compose --profile llm up -d
LEP_ADAPTER_LLM=fixture
LEP_LLM_BASE_URL=http://ollama:11434/v1
