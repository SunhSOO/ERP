LEP_ENV=development
LEP_SERVICE_NAME=lep-api
LEP_LOG_LEVEL=INFO

# 로컬 개발용 저장소. 서버는 infra/docker-compose.yml이 PostgreSQL을 준다.
LEP_DATABASE_URL=sqlite:///./.lep-dev.db
# 올린 과업지시서 원본을 둘 곳.
LEP_UPLOAD_DIR=./.lep-uploads

# ── 통합 어댑터 선택 (ADR-018) ──────────────────────────────────────────
# 기본값은 전부 fixture다. 실제 어댑터는 필요한 설정이 갖춰졌을 때만 켠다.
# 설정이 빠진 채로 켜면 픽스처로 남고 그 사유를 알려준다. 조용히 대체하지 않는다.

# 문서 변환기 — fixture | kordoc
# kordoc은 마크다운을 공문서 양식 HWPX로 만드는 Node CLI다.
# https://github.com/chrisryugj/kordoc
LEP_ADAPTER_CONVERTER=fixture
# 로컬 체크아웃의 CLI 진입점. node로 실행한다.
# LEP_KORDOC_CLI=C:/경로/kordoc/dist/cli.js
# 또는 경로 없이 npx로 실행한다. 첫 실행에 네트워크가 필요하다.
# LEP_KORDOC_USE_NPX=1
# 생성된 hwpx를 둘 디렉터리.
# LEP_KORDOC_OUTPUT_DIR=.kordoc-out

# 저장소 정합 — fixture | github
LEP_ADAPTER_VCS=fixture
# 개인 액세스 토큰. 저장소에 커밋하지 않는다. gh CLI를 쓴다면 `gh auth token`으로 얻는다.
# LEP_GITHUB_TOKEN=
# 모든 프로젝트가 한 저장소를 볼 때.
# LEP_GITHUB_REPO=SunhSOO/ERP
# 프로젝트마다 다른 저장소를 볼 때. JSON 객체다.
# LEP_GITHUB_REPOS={"prj-daon":"SunhSOO/ERP"}
# GitHub Enterprise를 쓸 때만.
# LEP_GITHUB_API_BASE=https://api.github.com

# 지식 볼트 — fixture | obsidian
# 옵시디언 볼트는 로컬 마크다운 폴더다. 편집은 옵시디언에서 하고 여기서는 읽는다.
LEP_ADAPTER_VAULT=fixture
# LEP_OBSIDIAN_VAULT=C:/경로/볼트
# 프로젝트별로 볼트 하위 폴더를 나눌 때. JSON 객체다.
# LEP_OBSIDIAN_PROJECT_DIRS={"prj-daon":"projects/daon"}

# 로컬 LLM — fixture만 지원한다. 실제 어댑터는 WP-PKD-033.
LEP_ADAPTER_LLM=fixture

# 하이웍스 메일 — fixture만 지원한다. 실제 어댑터는 WP-PKD-034.
LEP_ADAPTER_MAIL=fixture
